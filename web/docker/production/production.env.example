APP_NAME=OpenQDA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
ASSET_URL=${APP_URL}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (mysql service in docker-compose.prod.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=openqda
DB_USERNAME=openqda
DB_PASSWORD=change-me

# Read directly by the mysql container's own entrypoint (not by Laravel).
# Keep these in sync with DB_DATABASE/DB_USERNAME/DB_PASSWORD above.
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_DATABASE=openqda
MYSQL_USER=openqda
MYSQL_PASSWORD=change-me

# --- Sessions / cache / queue ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Redis (redis service in docker-compose.prod.yml) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-as-well
REDIS_CLIENT=phpredis

# --- Broadcasting / Reverb websocket server ---
BROADCAST_DRIVER=reverb
REVERB_APP_ID=openqda
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
# Public hostname/port clients use to reach Reverb (behind your reverse proxy)
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https
# Internal bind address/port inside the container (do not change unless you also edit docker/production/supervisord.conf)
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- File-to-HTML transform service (plugin-transform-convert-html container) ---
RTFENDPOINT=http://plugin-transform-convert-html:9666/convert

# --- Container housekeeping ---
# Set to "false" if you run migrations manually instead of on container start
RUN_MIGRATIONS=true
WWWUSER=1000
WWWGROUP=1000
