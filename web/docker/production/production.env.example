# Paste this whole file into Portainer's Stack "Environment variables" panel
# (Advanced mode lets you paste raw .env text), or use it as a local
# `--env-file` with `docker compose -f docker-compose.prod.yml`.
#
# Every value here is consumed directly by docker-compose.prod.yml's
# variable substitution (${VAR}) - there is no separate .env file inside
# the web/ directory in this setup.

APP_NAME=OpenQDA
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
ASSET_URL=${APP_URL}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (mysql service in docker-compose.prod.yml) ---
DB_DATABASE=openqda
DB_USERNAME=openqda
DB_PASSWORD=change-me
# Only used to initialize the mysql container itself (not read by Laravel).
MYSQL_ROOT_PASSWORD=change-me-too

# --- Sessions / cache / queue ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis

# --- Redis (redis service in docker-compose.prod.yml) ---
REDIS_PASSWORD=change-me-as-well
REDIS_CLIENT=phpredis

# --- Broadcasting / Reverb websocket server ---
BROADCAST_DRIVER=reverb
REVERB_APP_ID=openqda
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me
# Public hostname/port clients use to reach Reverb, e.g. through your
# reverse proxy. REVERB_PUBLIC_PORT is what browsers connect to (443 if
# proxied with TLS); REVERB_LOCAL_PORT is the host port docker-compose
# publishes the raw container port on (see "Ports" below).
REVERB_HOST=your-domain.example
REVERB_PUBLIC_PORT=443
REVERB_SCHEME=https

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

# --- Container housekeeping ---
# Set to "false" if you prefer to run migrations manually instead of on
# every container start.
RUN_MIGRATIONS=true
# Match these to the host user Docker runs as, so bind-mounted/named
# volumes keep sane file ownership (id -u / id -g on the host).
WWWUSER=1000
WWWGROUP=1000

# --- Ports published on the Docker host ---
# Change these if 8082/8083 collide with something else already running.
APP_PORT=8082
REVERB_LOCAL_PORT=8083
